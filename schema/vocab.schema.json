{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["en", "zh"]
      },
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["en", "zh"]
      },
      "family": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "required": ["id", "name", "definition"]
  },
  "minItems": 1
}
